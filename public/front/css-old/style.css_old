#bottom_top {
    display: inline-block;
    background-color: #da1a22;
    width: 50px;
    height: 50px;
    text-align: center;
    border-radius: 100%;
    position: fixed;
    bottom: 30px;
    right: 30px;
    transition: background-color .3s, opacity .5s, visibility .5s;
    opacity: 0;
    visibility: hidden;
    z-index: 1000;
    border: 2px solid #fff;
}
#bottom_top::after {
  content: "\f077";
  font-family: FontAwesome;
  font-weight: normal;
  font-style: normal;
  font-size: 25px;
  line-height: 50px;
  color: #fff;
}
#bottom_top:hover {
  cursor: pointer;
  background-color: #333;
}
#bottom_top:active {
  background-color: #555;
}
#bottom_top.show {
  opacity: 1;
  visibility: visible;
}

