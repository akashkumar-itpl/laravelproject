.mob{ display:none;}


.sticky{
   position: fixed;
   top: 0;
   width: 100%;
   left: 0px;
   z-index: 9999;
   background: #fff;
   width: 100%;
   transition: all 0.3s ease-in-out;
   animation: smoothScroll 1s forwards;
   box-shadow: 0px 0px 10px 0px rgba(0,0,0,0.2);
}
@keyframes smoothScroll {
    0% {
        transform: translateY(-40px);
    }
    100% {
        transform: translateY(0px);
    }
}


